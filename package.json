{
  "name": "segaloka",
  "version": "0.0.0",
  "private": true,
  "description": "Segaloka modular travel ecosystem platform",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "check:runtime": "node --version && pnpm --version",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "vitest": "5.0.0"
  }
}
